# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Canonical site URL. Also determines the base domain for band-site subdomain
# routing ({slug}.<domain> → /band-site/{slug}); defaults to corvmc.org when unset.
PUBLIC_SITE_URL=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Cloudflare Turnstile (bot protection on public sign-up, contact, subscribe forms)
# Leave blank locally to use Cloudflare's always-pass test keys.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Postmark (transactional email). In production this is a Worker secret; it is
# also required in the shell for `pnpm email:push` / `pnpm email:pull`, which
# sync postmark/templates/ with the Postmark server this token belongs to.
POSTMARK_SERVER_TOKEN=""
# Postmark message streams. Required — every send throws when either is unset.
# These are custom streams, not Postmark's defaults (`outbound`/`broadcast`), so
# both must exist with these ids on the server the token above belongs to.
POSTMARK_TRANSACTIONAL_STREAM="corvmc-transactional"
POSTMARK_BROADCAST_STREAM="corvmc-broadcast"
# Shared secret for Postmark's inbound webhook (/api/inbox/postmark). In production
# Postmark carries it as HTTP Basic auth in the hook URL; locally you can pass it as
# an x-postmark-token header. The route rejects every request when this is unset.
POSTMARK_INBOUND_TOKEN=""
# Base address for staff inbox replies. Set only once an MX record for this
# subdomain points at inbound.postmarkapp.com; unset, replies fall back to a
# Reply-To of STAFF_CONTACT_EMAIL. Also required to relay a staff member's
# emailed reply to the contact-form alert back into its thread — without it that
# alert replies straight to the sender and is not recorded.
# INBOX_REPLY_ADDRESS="reply@replies.corvmc.org"
# Signs the thread id in the plus-address. Falls back to POSTMARK_SERVER_TOKEN.
# INBOX_REPLY_SECRET=""
# Shared secret on Postmark's *message event* webhook (/api/webhooks/postmark/events),
# which is what records bounces and complaints as suppressions. The route 401s when
# this is unset, so campaigns keep mailing dead addresses until it is set.
POSTMARK_WEBHOOK_TOKEN=""
# Signs one-click unsubscribe links in marketing campaigns.
MARKETING_UNSUBSCRIBE_SECRET=""

# Bearer token for the scheduled jobs under /api/cron/* (scheduled campaign sends,
# waking snoozed inbox threads, lock codes). Unset, every cron endpoint 401s.
CRON_SECRET=""

# Twilio (staff inbox SMS channel). Leave unset to keep the SMS channel dormant —
# the channel toggle in Staff Settings surfaces the same requirement.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Meta / Messenger (staff inbox, unprovisioned by design — see the operations manual)
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""

# Cloudflare for SaaS — premium bands connecting their own domain. The token needs
# Zone > SSL and Certificates > Edit on the zone below. With either unset, the custom
# domain section reports itself unavailable instead of failing mid-setup; every band
# still gets {slug}.corvmc.org, which needs no credentials.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
# Optional: Cloudflare Image Transformations. Base host + the fixed /cdn-cgi/image
# prefix; getPublicUrl appends "<options>/<key>". Unset, images are served as raw
# originals. Production sets this in wrangler.toml [vars]. Leave it empty locally
# unless you are deliberately pointing dev at the production bucket.
# R2_TRANSFORM_URL="https://media.corvmc.org/cdn-cgi/image"
# Set to any non-empty value only when transformations are served from the apex
# zone rather than the bucket's own custom domain — makes the transform source an
# absolute R2_PUBLIC_URL rather than a bare key.
# R2_TRANSFORM_SOURCE_ABSOLUTE=""
