# Playwright
test-results
# Vitest browser-mode failure screenshots. Configured into `test-results/` in
# vite.config.ts; this catches whatever an older checkout already wrote, because
# the path is a directory named like a source file and the `scripts/` grep gates
# read every path their globs return.
__screenshots__/
# Attachments the browser reporter writes beside a failure screenshot.
.vitest-attachments/

*storybook.log
storybook-static
test-results.json

# Migration
scripts/.id-map.json
# Transient D1 sync artifacts (contain production data — never commit)
d1-seed.sql
d1-seed-ordered.sql
d1-delete.sql

