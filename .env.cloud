# Environment for Claude Code cloud sessions (claude.ai/code).
#
# A cloud session is a fresh clone on a throwaway VM with no `.env` — and
# `src/lib/server/auth.ts` throws without ORIGIN, so the app does not boot at all
# without one. `scripts/claude/cloud-session-start.sh` copies this file to `.env`
# and `.dev.vars` at session start, and only there: the CLAUDE_CODE_REMOTE check
# in that script keeps it away from your own checkout.
#
# Every value here is a dummy and this file is tracked, so NOTHING SECRET GOES IN
# IT. That is the point rather than a caveat — the local `.env` carries a live
# `rk_live` Stripe key, and a tracked file of fakes is how a cloud session gets a
# working app without anyone being tempted to paste real credentials into the
# environment's variables field (which anyone using the environment can read).
#
# What the blanks buy, all of it documented in `.env.example`:
#   - Turnstile blank -> Cloudflare's always-pass test keys, so sign-up works
#   - Stripe blank    -> the fake payments driver (PAYMENTS_DRIVER's default)
#   - R2 blank        -> media emulated by wrangler's platform proxy
# Anything that actually reaches Postmark, Twilio or Stripe will fail in a cloud
# session. That is the trade for keeping the environment secretless.

# A cloud clone is not under .claude/worktrees/, so scripts/lib/checkout-ports.ts
# gives it the main checkout's ports: 5173 dev, 4173 preview. ORIGIN must match
# the port actually served or auth fails rather than erroring cleanly.
ORIGIN="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:5173"

BETTER_AUTH_SECRET="cloud-session-dev-secret-not-for-production"

# Unused locally — only some unreferenced Postgres one-offs in scripts/ read it.
DATABASE_URL=""

# Blank on purpose: Cloudflare's always-pass test keys.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Blank on purpose: the fake payments driver.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Streams are required — every send throws when either is unset — so they are set
# even though the token below cannot reach Postmark.
POSTMARK_SERVER_TOKEN=""
POSTMARK_TRANSACTIONAL_STREAM="corvmc-transactional"
POSTMARK_BROADCAST_STREAM="corvmc-broadcast"
POSTMARK_INBOUND_TOKEN="cloud-session-dev-inbound"
POSTMARK_WEBHOOK_TOKEN="cloud-session-dev-webhook"

MARKETING_UNSUBSCRIBE_SECRET="cloud-session-dev-unsubscribe"
CRON_SECRET="cloud-session-dev-cron"

# Dormant without credentials, which is the intended state here.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""

CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
