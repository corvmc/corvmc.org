{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "@cloudflare/workers-types"],
		// `#lib` already resolves through package.json `imports`. Stating it here as
		// well is for typed ESLint: resolved only through `imports`, projectService
		// slows superlinearly, and the whole tree outran CI's lint cap (#2374).
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	// Globs rather than "src": scripts/coverage.spec.ts reads them to prove every
	// source file is compiled by some project.
	"include": [
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts",
		"drizzle.config.ts"
	],
	// Paraglide's generated output: one JSDoc-typed module per message, ~6,000 of
	// them, which as `checkJs` roots cost CI's svelte-check a quarter of its run.
	// Imports still resolve their types; `server.js` (the request middleware) is
	// never imported and its `Request` typing disagrees with @cloudflare/workers-types.
	"exclude": ["node_modules", "src/lib/paraglide/**"]
}
